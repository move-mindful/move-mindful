# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk routes. Both AFTER_ values track MEMBER_HOME in src/lib/routes.ts — the
# signed-in root, reachable without an entitlement. Keep them in sync.
# Flows that need a different landing pass ?redirect_url=<relative path> to
# /sign-up instead (the pricing page and the product pages both do), rather than
# bending these globals toward one flow at the expense of the others.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/home
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/home

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# RevenueCat
NEXT_PUBLIC_REVENUECAT_API_KEY=rcb_...
# Server-side REST key (secret — do NOT prefix with NEXT_PUBLIC_). Used to grant
# free promotional entitlements from the hidden /join signup page.
REVENUECAT_SECRET_API_KEY=sk_...

# Hidden free-membership signup page. The unlisted URL is /join/<this value>.
# Leave blank to disable the page entirely.
JOIN_SECRET_SLUG=

# Clerk webhook signing secret (Svix). From the Clerk dashboard → Webhooks →
# your endpoint (https://<domain>/api/webhooks/clerk), subscribed to
# user.created (Mailchimp/ManyChat signup, RevenueCat names), user.updated
# (RevenueCat names) and user.deleted (removes the member's database rows).
# Without it the route 500s so Clerk retries rather than dropping signups.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Mailchimp — the marketing audience. New Clerk signups are added and tagged
# with the product slug they signed up from; RevenueCat purchases add and remove
# the ownership tags. The datacenter is read off the key's "-us21" suffix, so
# there's no separate region setting. Leave blank to disable.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# RevenueCat webhook — a shared secret you invent (openssl rand -base64 32).
# RevenueCat does NOT sign its payloads: you paste this same string into the
# webhook's "Authorization header value" field in the dashboard and it sends it
# back verbatim, so this is the only thing standing between the receiver and
# anyone who finds the URL. Make it long, and rotate both sides together.
REVENUECAT_WEBHOOK_AUTH=

# ManyChat — tags contacts `signup` and `purchased:<slug>` from the Clerk and
# RevenueCat webhooks (see manychat.md). ManyChat → Settings → API. Regenerating
# the key disables every connected method, so rotate both sides together.
# Leave blank to disable.
MANYCHAT_API_TOKEN=

# Mux (server-side only — do NOT prefix with NEXT_PUBLIC_)
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret

# Stream — the group chat at /chat (admin-only for now). getstream.io →
# dashboard → your app (US East) → API key and secret. The key is public: the
# browser connects with it. The secret is server-only (do NOT prefix with
# NEXT_PUBLIC_) — it signs each person's chat token, so whoever has it can
# post as anyone. Without them /chat says chat isn't set up. The secret also
# checks Stream's webhooks (the Chat tab's dot, the trainers-only video
# check); scripts/stream-hooks.mjs points those at the site.
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# Optional: override the persistent live stream playback ID shown on /live.
# Playback IDs are public, so NEXT_PUBLIC_ is fine here. The live page also
# uses this ID to match against Mux's active live-stream status. Defaults to the
# studio's live stream if unset.
NEXT_PUBLIC_MUX_LIVESTREAM_PLAYBACK_ID=

# Anthropic — "Generate with AI" in the admin workout builder, where Claude
# drafts a workout from the exercise library and the published workouts.
# Server-only (do NOT prefix with NEXT_PUBLIC_). console.anthropic.com → API keys.
# Leave blank to disable: the builder shows an error when it's used.
ANTHROPIC_API_KEY=

# ElevenLabs — voice announcements in the workout player (planned: plan.md →
# Phase 4.5): short spoken lines like "Next up: bicep curl. Ten reps.", made
# once per workout on the server. Server-only (do NOT prefix with NEXT_PUBLIC_).
# elevenlabs.io → Developers → API keys; a restricted key needs Text to Speech
# and Voices (read). Without it, the builder says so after a save and the
# player goes without announcements.
ELEVENLABS_API_KEY=
